# GEMINI_API_KEY: Required for live Google Gemini AI vision triage.
# In AI Studio, inject this via the Secrets panel.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Configurable Gemini model identifier (default: gemini-3.8-flash)
GEMINI_MODEL="gemini-3.8-flash"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Port on which the application server runs (default: 3000)
PORT=3000
