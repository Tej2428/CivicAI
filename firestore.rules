rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isOfficerOrAdmin() {
      return isAuthenticated() && (getUserRole() == 'officer' || getUserRole() == 'admin');
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    // User profiles collection
    match /users/{userId} {
      // Any authenticated user can read public officer profiles; private users can read their own
      allow read: if isAuthenticated() && (request.auth.uid == userId || isOfficerOrAdmin());
      // Users can only create or update their own basic profile, but role elevation requires admin
      allow create: if isAuthenticated() && request.auth.uid == userId && (!('role' in request.resource.data) || request.resource.data.role == 'citizen');
      allow update: if isAuthenticated() && (isAdmin() || (request.auth.uid == userId && request.resource.data.role == resource.data.role));
      allow delete: if isAdmin();
    }

    // Reports collection
    match /reports/{reportId} {
      // Public can read basic complaint summaries without personal data
      allow read: if true;

      // Authenticated citizens can submit new complaints
      allow create: if isAuthenticated()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'Submitted'
        && request.resource.data.keys().hasAll(['id', 'category', 'location', 'priority', 'status', 'createdAt']);

      // Only authorized officers & admins can update official status, assign teams, or record resolutions
      // Citizens CANNOT update status or assign teams
      allow update: if isOfficerOrAdmin() || (
        isAuthenticated()
        && request.auth.uid == resource.data.reporterId
        && request.resource.data.status == resource.data.status
        && request.resource.data.priority == resource.data.priority
      );

      allow delete: if isAdmin();

      // Protected internal officer notes subcollection
      match /internal_notes/{noteId} {
        // Citizens can NEVER read or write internal engineering notes
        allow read, write: if isOfficerOrAdmin();
      }
    }

    // Status transition audit logs
    match /audit_logs/{logId} {
      allow read: if isOfficerOrAdmin();
      // Immutable write
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable audit log
    }

    // Notifications collection
    match /notifications/{notifId} {
      // Users can only read and update their own notifications
      allow read, update: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    // System configuration collection (weights, SLAs, radius)
    match /system_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
